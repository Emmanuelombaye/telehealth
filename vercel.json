{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin\\.(?<domain>.+)" }],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "superadmin\\.(?<domain>.+)" }],
      "destination": "/superadmin",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "doctor\\.(?<domain>.+)" }],
      "destination": "/doctor",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "patient\\.(?<domain>.+)" }],
      "destination": "/patient",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/patient/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Portal", "value": "patient" }
      ]
    },
    {
      "source": "/doctor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Portal", "value": "doctor" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Portal", "value": "admin" }
      ]
    },
    {
      "source": "/superadmin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Portal", "value": "superadmin" }
      ]
    },
    {
      "source": "/pharmacy/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Portal", "value": "pharmacy" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
