# Copy to .env.production (or set in your host / CI) before `vite build`.
# Never commit real secrets.

# Required — app cannot run without these
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Required for real card checkout in production builds
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional — checkout UX
# Set to "true" to show only Stripe (card) in the payment picker.
# VITE_CHECKOUT_STRIPE_ONLY=true
# Set to "true" on staging to allow simulated wallet checkout without live PayPal / Apple / Google APIs.
# VITE_ENABLE_DEMO_ALT_GATEWAYS=true

# Optional — scheduling / video enrollment
VITE_CALENDLY_DEFAULT_URL=
VITE_SCHEDULING_EMBED_URL=
VITE_VIDEO_REQUIRED_STATES=

# Optional — Referly affiliate script (injected at build via vite.config)
VITE_REFERLY_SITE_ID=
