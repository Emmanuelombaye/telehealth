# Copy to .env.production (or set in your host / CI) before `vite build`.
# Never commit real secrets.

# Required — app cannot run without these
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Required for real card checkout in production builds
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional — real SMS OTP during enrollment (requires send-otp + verify-otp deployed + Twilio secrets)
# VITE_SHOP_LIVE_OTP=true
# Set to "true" to show only Stripe (card) in the payment picker.
# VITE_CHECKOUT_STRIPE_ONLY=true
# Set to "true" on staging to allow simulated wallet checkout without live PayPal / Apple / Google APIs.
# VITE_ENABLE_DEMO_ALT_GATEWAYS=true

# Optional — live Calendly/Cal.com (off by default; frontend uses mock demo slots)
# VITE_USE_LIVE_SCHEDULING=true
# VITE_CALENDLY_DEFAULT_URL=https://calendly.com/your-org/event
# VITE_SCHEDULING_EMBED_URL=https://calendly.com/your-org/event
VITE_VIDEO_REQUIRED_STATES=

# Optional — staging gate: npm run check:scheduling-gate (set in shell, not Vite)
# SCHEDULING_GATE_STRICT=1
# SUPABASE_SERVICE_ROLE_KEY=   # server-only: node scripts/apply-clinical-intake-seed.mjs (never commit)
# Optional — Partner API (Swagger / catalog / enrollment)
# VITE_PARTNER_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/partner-api

# Optional — partner marketing URLs (login back-links)
# VITE_SUMMIT_MD_SHOP_URL=https://summitmd.vercel.app/shop
# VITE_NORTH_STAR_SHOP_URL=https://joinnorthstarmd.com
# White-label Referly partner portal (affiliate login / payouts)
# White-label Referly partner portal (affiliate login / payouts)
VITE_REFERLY_PARTNER_PORTAL_URL=https://partners.peak-health.io

# ---------------------------------------------------------------------------
# PMCI Hub — Pharmacy email-based order submission (Edge Function secrets)
# Set these in: Supabase Dashboard → Settings → Edge Functions → Secrets
# (Do NOT prefix with VITE_ — these are server-side only, never exposed to browser)
# ---------------------------------------------------------------------------
# Receiving mailbox provided by PMCI Hub (e.g. yourpartner@pmcihub.com)
# PMCI_MAILBOX=

# Authorized sending address — must match domain whitelisted with PMCI
# PMCI_FROM_EMAIL=rx@peak-health.io

# Subject line prefix. PMCI uses this for routing. Agree exact string with PMCI Hub.
# PMCI_SUBJECT_PREFIX=Peak Health Prescription Order Submission

# Shared HMAC-SHA256 secret. PMCI includes X-PMCI-Signature: sha256=<hex> on every webhook.
# Generate with: openssl rand -hex 32
# PMCI_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# ThriveWell Rx — External Prescription API (Edge Function secrets)
# Set these in: Supabase Dashboard → Settings → Edge Functions → Secrets
# Credentials provided by your ThriveWell pharmacy contact.
# ---------------------------------------------------------------------------
# Clinic username assigned by ThriveWell Rx
# THRIVEWELL_USERNAME=

# Clinic password assigned by ThriveWell Rx
# THRIVEWELL_PASSWORD=

# API base URL (default: https://flow.thrivewellrx.com/api — override for staging)
# THRIVEWELL_BASE_URL=https://flow.thrivewellrx.com/api
